# 化学引擎测试运行环境
#
# 用途：本机 Windows 启用了 Smart App Control（VerifiedAndReputablePolicyState=1），
# 按二进制签名拦截未签名的第三方原生扩展（RDKit、grpcio 等），导致
# `backend/tests/chem/` 无法在 Windows venv 中运行（详见
# docs/chem-engine-verification.md §2）。
#
# Docker 容器内的二进制不受主机应用控制策略管辖，因此测试在此环境中执行。
#
# 构建：docker build -f backend/tests/Dockerfile.test -t xuezhi-chem-test .
#   注意：修改依赖后必须重建。若用 `docker build -q`（仅输出镜像 ID）在改完
#   Dockerfile 后又跑了其他命令，镜像可能停留在旧版——实测踩过：
#   Dockerfile 已加 sentence-transformers，镜像内却没有，排查耗时。
#   建议改依赖后用 `docker build --no-cache` 确认。
# 运行：docker run --rm xuezhi-chem-test
FROM python:3.12-slim

# 固定版本，保证测试环境可复现（版本依据 docs/dependency-notes.md 实测记录）
# RDKit 官方建议优先使用 conda-forge；此处用 pip 轮子，因容器内 conda 求解代价过高。
# langchain-openai 供 backend-llm / backend-agent 模块测试（纯逻辑，不发真实请求）。
# chromadb 供 backend-rag 模块测试；sentence-transformers 供中文嵌入模型
# （实测 chromadb 内置 EF 是英文模型，中文检索排序颠倒，见 docs/rag-verification.md §2.1）。
#
# fastapi / uvicorn / pydantic 供 backend-api 模块测试（版本与
# requirements-lock.txt 一致，2026-10-04 实测确认）。
# httpx2 而非 httpx：starlette 1.x 的 TestClient 已迁移到 httpx2，
# 只装httpx 会触发 DeprecationWarning，而 pytest.ini 把
# DeprecationWarning 设为 error（见 backend/tests/api/ 与
# docs/interface-contract-verification.md §4）。
#
# pip 超时与重试：实测在本机构建时下载 torch（554MB）会
# ReadTimeoutError；更严重的一次是代理返回**内容损坏但传输完成**的包
# （zstandard 5.5MB，sha256 不匹配 → "THESE PACKAGES DO NOT MATCH THE
# HASHES"）。加长超时并允许多次重试以应对抖动。
ENV PIP_DEFAULT_TIMEOUT=180 \
    PIP_RETRIES=8 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 分层安装（刻意）：重依赖链条（含 torch 554MB+triton 248MB）与
# Web 层依赖分开。理由是实测教训——一次网络抖动导致整层失败时，
# 分层后可只重跑失败的那层，不必重下 554MB。
# 首次构建约 20 分钟，后续命中缓存仅需数秒。
#
# 第 1 层：科学计算与检索链条（RDKit / chromadb / torch 链条 / 中文嵌入）
RUN pip install --no-cache-dir \
        rdkit==2026.3.6 \
        pytest==9.1.1 \
        langchain-openai==1.6.7 \
        chromadb==1.5.9 \
        sentence-transformers==6.1.0

# 第 2 层：Web 服务层（backend-api 模块）
#
# 版本与 requirements-lock.txt 一致（2026-10-04 实测确认）。
# httpx2 而非 httpx：starlette 1.x 的 TestClient 已迁移到 httpx2，
# 只装 httpx 会触发 DeprecationWarning，而 pytest.ini 把
# DeprecationWarning 设为 error（见 backend/tests/api/ 与
# docs/interface-contract-verification.md §4）。
RUN pip install --no-cache-dir \
        fastapi==0.142.2 \
        "uvicorn[standard]==0.54.0" \
        pydantic==2.13.5 \
        httpx2==2.13.1

# 第 3 层：语音（backend-speech）
#
# edge-tts 是**纯 Python wheel**（实测 edge_tts-7.2.8-py3-none-any.whl），
# 无原生扩展 —— 故本层不受 WDAC 拦截影响（但同层的
# sentence-transformers 链条里 torch 有原生扩展，
# 是否能加载取决于发行来源，见 docs/dependency-notes.md）。
#
# 装它的目的：让 speech 测试能在**真实包**下跑，而不是只靠替身。
# 本项目已三次因替身与真实依赖不一致而误判（见
# docs/development-log-2026-10.md），语音依赖必须实跑验证。
#
# 注意：edge-tts 调用微软在线服务，测试中**不真调合成**
# （只验证 API 契约与错误语义），故无需联网。
RUN pip install --no-cache-dir edge-tts==7.2.8

# 第 4 层：schema 校验
#
# jsonschema 供backend/tests/chem/test_viz_schema.py 的F5 契约测试。
# **必须有真实校验器**：手写字段检查只能验证"我想到的约束"，
# 验证不了 schema 本身写得对不对（实测踩过——
# 手工检查全过，但schema 里少写一条约束时无从发现）。
#
# 4.26.0 实测 requires_python>=3.10，兼容 3.12 基线（H1）。
# 其传递依赖含 rpds-py（Rust 扩展）——**本机可能被应用控制策略拦截**，
# 故该项测试须在容器内跑（与本文件存在的理由一致）。
RUN pip install --no-cache-dir jsonschema==4.26.0

WORKDIR /work
COPY backend /work/backend
COPY pytest.ini /work/pytest.ini
# 语料文件用于测试其自身的合规性（knowledge-data 模块的回归保护）
COPY data /work/data
# 文档须进镜像：backend/tests/knowledge/test_docs_format.py 会校验
# 表格格式、编号重复与死链。实测踩过——没 COPY docs 时该测试报
# FileNotFoundError，误以为格式检查通过。
COPY docs /work/docs
# 根 README.md 被死链检查引用（docs/README.md 的父目录）
COPY README.md /work/README.md

# 默认跑全量（不只是 chem），避免"改了别的模块但只跑了 chem"漏过回归。
# 若只想跑化学引擎：docker run --rm xuezhi-chem-test \
#   python -m pytest backend/tests/chem/
CMD ["python", "-m", "pytest", "backend/tests/", "--no-header"]
