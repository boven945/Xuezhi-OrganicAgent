# Xuezhi-OrganicAgent 本地配置模板
#
# 用法：复制为 .env 后按需修改。
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，**不会被提交**。
# 本文件不得出现任何真实密钥值（见 security-privacy.md §3）。


# ======================================================================
# 模型服务（华为 ModelArts MaaS）
# ======================================================================

# 模型服务密钥。**必填**，否则问答接口返回 llm_not_configured。
# 获取方式见 docs/llm-adapter-verification.md。
# 留空则服务仍可启动——/health 与 /ready 可用，便于先跑通链路再去申请密钥。
MAAS_API_KEY=

# 模型标识。取值须为官方文档确认的值（见 app/llm/config.py 的 MAAS_MODELS）。
MAAS_MODEL=openpangu-2.0-flash

# OpenAI 兼容端点。默认值即此，一般不改。
MAAS_BASE_URL=https://api.modelarts-maas.com/openai/v1


# ======================================================================
# API 服务
# ======================================================================

# 允许的跨域来源，逗号分隔。**留空则完全不注册 CORS**（纯后端调用场景）。
# 本地开发填前端地址，例如：http://localhost:5173
XUEZHI_CORS_ORIGINS=

# 限流：每秒补充的令牌数 + 突发桶容量。
# 实测本机默认值偏紧（1/s），演示时可放宽。
XUEZHI_RATE_LIMIT_RPS=2
XUEZHI_RATE_LIMIT_BURST=10

# 单请求端到端超时（秒）。实测模型中位延迟 7.1 秒，偶发可达数十秒。
XUEZHI_REQUEST_TIMEOUT=120

# 设为 1 时，配置不全会让进程启动失败（生产建议开启；
# 本地开发保持 0，否则忘配密钥会导致服务起不来）。
XUEZHI_STRICT_STARTUP=0


# ======================================================================
# 知识库
# ======================================================================

# 向量库持久化目录。**不得由用户输入决定**（security-privacy.md §4）。
XUEZHI_CHROMA_PATH=data/chroma

# 集合名。chromadb 只接受 [a-zA-Z0-9._-]，且长度须 >= 3。
XUEZHI_COLLECTION=xuezhi_organic

# 索引版本，与评估报告对应。变更须同步更新 docs/。
XUEZHI_INDEX_VERSION=unversioned

# 本地嵌入模型权重目录（约 400MB）。
# **设了则离线加载**——断网演示必须预先下载权重。
# 留空则在线从 HuggingFace 下载（需代理，且首次启动较慢）。
XUEZHI_EMBEDDING_PATH=

# 检索相似度阈值。**留空表示不设阈值**。
#
# 为什么默认不设：实测语料从 6 条增至 41 条后，
# None/0.4/0.5/0.6/0.7 五个阈值的 top3 命中率**完全相同**（均 96.97%），
# 设一个没有实测依据的阈值只会制造"已调优"的假象。
# 详见 docs/organic-corpus-verification.md 与决策登记表 I1。
XUEZHI_RETRIEVAL_THRESHOLD=

# 单次检索返回条数。
XUEZHI_RETRIEVAL_TOP_K=4


# ======================================================================
# 语音与数字人（backend-speech）
# ======================================================================
#
# 语音是**可降级能力**：不可用时文本答复照常交付
# （见 docs/architecture.md §6）。以下配置均非密钥。

# 是否启用语音合成。设为 0 则不调用 edge-tts，/health 报 tts=未启用。
XUEZHI_TTS_ENABLED=1

# edge-tts 音色名。留空则回落默认值 zh-CN-XiaoxiaoNeural。
#
# 注意：edge-tts **调用微软在线服务**，断网时合成必然失败。
# 断网演示须改用本地 TTS，该项已登记为未决（决策 B5）。
XUEZHI_TTS_VOICE=zh-CN-XiaoxiaoNeural

# 语速调整，范围 -50 到 100（百分比）。
#
# 教学场景默认 0（不放慢）：模型中位延迟 7.1 秒（决策 A3），
# 语速再慢会加剧"话没说完就出下一题"的错位感。
XUEZHI_TTS_RATE=0

# 单次合成的字符上限，默认 400。超长文本会在句子边界截断并标注。
XUEZHI_TTS_MAX_CHARS=400

# 是否向 Fay 数字人推送播报文本。默认关闭。
XUEZHI_FAY_ENABLED=0

# Fay 服务基址。**XUEZHI_FAY_ENABLED=1 时必填**，否则启动即报错
# （静默忽略更糟——会让人以为数字人已接管）。
#
# 契约实测自官方源码 gui/flask_server.py（2026-10-04）：
# POST {基址}/transparent-pass，body {"user": "...", "text": "...", "audio": null}
# 业务失败仍返回 HTTP 200，必须读 body 的 code 字段。
# 详见 docs/speech-module-verification.md。
XUEZHI_FAY_URL=http://127.0.0.1:5000

# 推送超时（秒）。默认 10。
XUEZHI_FAY_TIMEOUT=10

# 音频临时存放目录。默认系统临时目录下的 xuezhi-audio。
#
# **多 worker 部署时必须让所有 worker 指向同一目录**——
# 否则 A 进程生成的音频 B 进程读不到，表现为间歇性 404，
# 极难排查（已登记为决策 H23）。单 worker 无此问题。
XUEZHI_AUDIO_DIR=
